// Writes the Claude Code plugin (the authoring skill and the MCP server together) and the marketplace file that
// lists it, from the skill and the product version. The files are committed: Claude Code reads them straight from
// the public repository (claude plugin marketplace add <owner>/open-libka-design-platform). A test fails when they
// are stale.
//
//   node npm/build-plugin.mts
//
//   .claude-plugin/marketplace.json                 the marketplace "libka" with one plugin, ./plugins/libka
//   plugins/libka/.claude-plugin/plugin.json        the plugin: name, version, the MCP server
//   plugins/libka/launch.mjs                        starts the MCP server of the same version through npx
//   plugins/libka/skills/libka-author/              the skill (SKILL.md and the generated reference.md)
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const skill = join(root, '.claude', 'skills', 'libka-author');

const DESCRIPTION = 'Write LibKa documents with Claude: the authoring skill and the LibKa MCP server, which checks LibKa Markdown and builds it into a web page, an A4 PDF, 16:9 slides and a Word file, each checked for accessibility and signed.';

/** Every file of the plugin and the marketplace: path → text. */
export function pluginFiles(version = (JSON.parse(readFileSync(join(root, 'package.json'), 'utf8')) as { version: string }).version): Record<string, string> {
  const json = (v: unknown) => JSON.stringify(v, null, 2) + '\n';
  return {
    '.claude-plugin/marketplace.json': json({
      name: 'libka',
      owner: { name: 'LibKa' },
      metadata: { description: 'LibKa for Claude Code: the authoring skill and the MCP server.', version },
      plugins: [{
        name: 'libka', source: './plugins/libka', description: DESCRIPTION, version, license: 'Apache-2.0',
        keywords: ['documents', 'accessibility', 'wcag', 'pdf', 'slides', 'markdown', 'mcp'], category: 'productivity',
      }],
    }),
    'plugins/libka/.claude-plugin/plugin.json': json({
      name: 'libka', version, description: DESCRIPTION, author: { name: 'LibKa' }, license: 'Apache-2.0',
      keywords: ['documents', 'accessibility', 'wcag', 'pdf', 'slides', 'markdown', 'mcp'],
      mcpServers: { libka: { command: 'node', args: ['${CLAUDE_PLUGIN_ROOT}/launch.mjs'] } },
    }),
    'plugins/libka/launch.mjs': `// Starts the LibKa MCP server ${version} (npm: @libka/mcp) for the plugin. Through node, so it starts the same way on
// Windows, macOS and Linux; npx downloads the server once and keeps it in npm's cache. Generated by npm/build-plugin.mts.
import { spawn } from 'node:child_process';

const child = spawn('npx', ['-y', '@libka/mcp@${version}'], { stdio: 'inherit', shell: process.platform === 'win32' });
child.on('exit', (code, signal) => process.exit(code ?? (signal ? 1 : 0)));
child.on('error', (e) => { console.error(\`libka plugin: could not start npx (\${e.message}); LibKa needs Node.js 22.18 or newer\`); process.exit(1); });
for (const s of ['SIGINT', 'SIGTERM']) process.on(s, () => child.kill(s));
`,
    'plugins/libka/skills/libka-author/SKILL.md': readFileSync(join(skill, 'SKILL.md'), 'utf8'),
    'plugins/libka/skills/libka-author/reference.md': readFileSync(join(skill, 'reference.md'), 'utf8'),
  };
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const files = pluginFiles();
  for (const [path, text] of Object.entries(files)) {
    mkdirSync(dirname(join(root, path)), { recursive: true });
    writeFileSync(join(root, path), text);
  }
  console.log(`build-plugin: wrote ${Object.keys(files).length} files`);
}
