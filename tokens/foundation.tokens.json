{
  "typography": {
    "font": {
      "$type": "fontFamily",
      "brand": {
        "$value": ["Fraunces", "Instrument Serif", "Georgia", "serif"],
        "$extensions": {"org.libka": {"css": "\"Fraunces\", \"Instrument Serif\", Georgia, serif", "docx": "Georgia"}}
      },
      "ui": {
        "$value": ["Inter", "Manrope", "system-ui", "sans-serif"],
        "$extensions": {"org.libka": {"css": "\"Inter\", \"Manrope\", system-ui, sans-serif", "docx": "Arial"}}
      },
      "mono": {
        "$value": ["JetBrains Mono", "Consolas", "monospace"],
        "$extensions": {"org.libka": {"css": "\"JetBrains Mono\", Consolas, monospace", "docx": "Consolas"}}
      }
    },
    "scale": {
      "display": {
        "xl": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.brand}",
            "fontSize": {"value": 7, "unit": "rem"},
            "fontWeight": 650,
            "letterSpacing": {"value": -0.28, "unit": "rem"},
            "lineHeight": 0.96
          },
          "$description": "Fluid size; $value is the maximum, the exact clamp() is in $extensions.",
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.04em", "fontSize": "clamp(3.8rem, 8vw, 7rem)"}}}
        },
        "lg": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.brand}",
            "fontSize": {"value": 5, "unit": "rem"},
            "fontWeight": 650,
            "letterSpacing": {"value": -0.175, "unit": "rem"},
            "lineHeight": 0.98
          },
          "$description": "Fluid size; $value is the maximum, the exact clamp() is in $extensions.",
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.035em", "fontSize": "clamp(3rem, 6vw, 5rem)"}}}
        }
      },
      "heading": {
        "h1": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.brand}",
            "fontSize": {"value": 3.8, "unit": "rem"},
            "fontWeight": 700,
            "letterSpacing": {"value": -0.114, "unit": "rem"},
            "lineHeight": 1.02
          },
          "$description": "Fluid size; $value is the maximum, the exact clamp() is in $extensions.",
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.03em", "fontSize": "clamp(2.4rem, 5vw, 3.8rem)"}}}
        },
        "h2": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.brand}",
            "fontSize": {"value": 2.8, "unit": "rem"},
            "fontWeight": 650,
            "letterSpacing": {"value": -0.07, "unit": "rem"},
            "lineHeight": 1.08
          },
          "$description": "Fluid size; $value is the maximum, the exact clamp() is in $extensions.",
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.025em", "fontSize": "clamp(1.9rem, 4vw, 2.8rem)"}}}
        },
        "h3": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.ui}",
            "fontSize": {"value": 1.4, "unit": "rem"},
            "fontWeight": 650,
            "letterSpacing": {"value": -0.028, "unit": "rem"},
            "lineHeight": 1.2
          },
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.02em"}}}
        },
        "h4": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.ui}",
            "fontSize": {"value": 1.125, "unit": "rem"},
            "fontWeight": 700,
            "letterSpacing": {"value": -0.0112, "unit": "rem"},
            "lineHeight": 1.3
          },
          "$extensions": {"org.libka": {"css": {"letterSpacing": "-0.01em"}}}
        }
      },
      "body": {
        "lg": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.ui}",
            "fontSize": {"value": 1.125, "unit": "rem"},
            "fontWeight": 450,
            "letterSpacing": {"value": 0, "unit": "rem"},
            "lineHeight": 1.7
          },
          "$extensions": {"org.libka": {"css": {"letterSpacing": "0"}}}
        },
        "md": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.ui}",
            "fontSize": {"value": 1, "unit": "rem"},
            "fontWeight": 450,
            "letterSpacing": {"value": 0, "unit": "rem"},
            "lineHeight": 1.6
          },
          "$extensions": {"org.libka": {"css": {"letterSpacing": "0"}}}
        },
        "sm": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{typography.font.ui}",
            "fontSize": {"value": 0.875, "unit": "rem"},
            "fontWeight": 450,
            "letterSpacing": {"value": 0, "unit": "rem"},
            "lineHeight": 1.5
          },
          "$extensions": {"org.libka": {"css": {"letterSpacing": "0"}}}
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.font.ui}",
          "fontSize": {"value": 0.75, "unit": "rem"},
          "fontWeight": 600,
          "letterSpacing": {"value": 0.045, "unit": "rem"},
          "lineHeight": 1.4
        },
        "$extensions": {"org.libka": {"css": {"letterSpacing": "+0.06em"}}}
      },
      "overline": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.font.ui}",
          "fontSize": {"value": 0.6875, "unit": "rem"},
          "fontWeight": 800,
          "letterSpacing": {"value": 0.11, "unit": "rem"},
          "lineHeight": 1.4
        },
        "$extensions": {"org.libka": {"textTransform": "uppercase", "css": {"letterSpacing": "+0.16em"}}}
      },
      "code": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.font.mono}",
          "fontSize": {"value": 0.8125, "unit": "rem"},
          "fontWeight": 500,
          "letterSpacing": {"value": 0, "unit": "rem"},
          "lineHeight": 1.5
        },
        "$extensions": {"org.libka": {"css": {"letterSpacing": "0"}}}
      },
      "$description": "letterSpacing $value is the em value at the maximum font size in rem; the exact em value used in CSS is in $extensions."
    }
  },
  "spacing": {
    "$type": "dimension",
    "0_5": {"$value": {"value": 2, "unit": "px"}},
    "1": {"$value": {"value": 4, "unit": "px"}},
    "2": {"$value": {"value": 8, "unit": "px"}},
    "3": {"$value": {"value": 12, "unit": "px"}},
    "4": {"$value": {"value": 16, "unit": "px"}},
    "5": {"$value": {"value": 20, "unit": "px"}},
    "6": {"$value": {"value": 24, "unit": "px"}},
    "8": {"$value": {"value": 32, "unit": "px"}},
    "10": {"$value": {"value": 40, "unit": "px"}},
    "12": {"$value": {"value": 48, "unit": "px"}},
    "16": {"$value": {"value": 64, "unit": "px"}},
    "20": {"$value": {"value": 80, "unit": "px"}},
    "24": {"$value": {"value": 96, "unit": "px"}},
    "32": {"$value": {"value": 128, "unit": "px"}}
  },
  "density": {
    "comfortable": {
      "rowHeight": {"$type": "dimension", "$value": {"value": 44, "unit": "px"}},
      "controlPaddingY": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
      "controlPaddingX": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
      "stackGap": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
      "fontScale": {"$type": "number", "$value": 1.0}
    },
    "compact": {
      "rowHeight": {"$type": "dimension", "$value": {"value": 36, "unit": "px"}},
      "controlPaddingY": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
      "controlPaddingX": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
      "stackGap": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
      "fontScale": {"$type": "number", "$value": 0.95}
    },
    "spacious": {
      "rowHeight": {"$type": "dimension", "$value": {"value": 56, "unit": "px"}},
      "controlPaddingY": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
      "controlPaddingX": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}},
      "stackGap": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}},
      "fontScale": {"$type": "number", "$value": 1.05}
    }
  },
  "radius": {
    "$type": "dimension",
    "xs": {"$value": {"value": 6, "unit": "px"}},
    "sm": {"$value": {"value": 10, "unit": "px"}},
    "md": {"$value": {"value": 16, "unit": "px"}},
    "lg": {"$value": {"value": 24, "unit": "px"}},
    "xl": {"$value": {"value": 32, "unit": "px"}},
    "2xl": {"$value": {"value": 40, "unit": "px"}},
    "full": {"$value": {"value": 999, "unit": "px"}}
  },
  "opacity": {
    "$type": "number",
    "disabled": {"$value": 0.45},
    "muted": {"$value": 0.65},
    "overlay": {"$value": 0.48},
    "hover": {"$value": 0.08},
    "subtle": {"$value": 0.05},
    "scrim": {"$value": 0.6}
  },
  "zIndex": {
    "$type": "number",
    "base": {"$value": 0},
    "raised": {"$value": 10},
    "sticky": {"$value": 20},
    "dropdown": {"$value": 30},
    "overlay": {"$value": 40},
    "drawer": {"$value": 50},
    "modal": {"$value": 60},
    "toast": {"$value": 70},
    "tooltip": {"$value": 80}
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": {"$value": {"value": 0, "unit": "px"}},
    "tablet": {"$value": {"value": 640, "unit": "px"}},
    "desktop": {"$value": {"value": 1024, "unit": "px"}},
    "wide": {"$value": {"value": 1440, "unit": "px"}},
    "maxContentWidth": {"$value": {"value": 1440, "unit": "px"}},
    "maxTextMeasure": {
      "$type": "number",
      "$value": 72,
      "$description": "Maximum text measure in ch (characters).",
      "$extensions": {"org.libka": {"css": "72ch"}}
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Dark mode uses pure-black shadows (visible against the dark canvas) plus the existing surface-lightening elevation. Light mode uses ink-based shadows.",
    "0": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 0, "unit": "px"},
        "blur": {"value": 0, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      },
      "$extensions": {"org.libka": {"css": "none"}}
    },
    "1": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.0667, 0.0902, 0.1373], "alpha": 0.06},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 1, "unit": "px"},
        "blur": {"value": 2, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    },
    "2": {
      "$value": [
        {
          "color": {"colorSpace": "srgb", "components": [0.0667, 0.0902, 0.1373], "alpha": 0.07},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": {"value": 4, "unit": "px"},
          "blur": {"value": 16, "unit": "px"},
          "spread": {"value": 0, "unit": "px"}
        },
        {
          "color": {"colorSpace": "srgb", "components": [0.0667, 0.0902, 0.1373], "alpha": 0.05},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": {"value": 1, "unit": "px"},
          "blur": {"value": 3, "unit": "px"},
          "spread": {"value": 0, "unit": "px"}
        }
      ]
    },
    "3": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.0667, 0.0902, 0.1373], "alpha": 0.14},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 20, "unit": "px"},
        "blur": {"value": 60, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    },
    "4": {
      "$value": {
        "color": {"colorSpace": "srgb", "components": [0.0667, 0.0902, 0.1373], "alpha": 0.2},
        "offsetX": {"value": 0, "unit": "px"},
        "offsetY": {"value": 32, "unit": "px"},
        "blur": {"value": 80, "unit": "px"},
        "spread": {"value": 0, "unit": "px"}
      }
    },
    "glow": {
      "aqua": {
        "$value": {
          "color": {"colorSpace": "srgb", "components": [0.1255, 0.7804, 0.851], "alpha": 0.18},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": {"value": 0, "unit": "px"},
          "blur": {"value": 36, "unit": "px"},
          "spread": {"value": 0, "unit": "px"}
        }
      },
      "iris": {
        "$value": {
          "color": {"colorSpace": "srgb", "components": [0.4784, 0.4863, 1.0], "alpha": 0.16},
          "offsetX": {"value": 0, "unit": "px"},
          "offsetY": {"value": 0, "unit": "px"},
          "blur": {"value": 28, "unit": "px"},
          "spread": {"value": 0, "unit": "px"}
        }
      }
    }
  },
  "motion": {
    "$description": "Under prefers-reduced-motion, only fade.in opacity is preserved; all transform-based presets resolve instantly.",
    "duration": {
      "$type": "duration",
      "instant": {"$value": {"value": 80, "unit": "ms"}},
      "fast": {"$value": {"value": 160, "unit": "ms"}},
      "base": {"$value": {"value": 240, "unit": "ms"}},
      "slow": {"$value": {"value": 480, "unit": "ms"}},
      "crawl": {"$value": {"value": 720, "unit": "ms"}}
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {"$value": [0.2, 0.8, 0.2, 1]},
      "soft": {"$value": [0.16, 1, 0.3, 1]},
      "sharp": {"$value": [0.4, 0, 0.2, 1]},
      "linear": {"$value": [0, 0, 1, 1], "$extensions": {"org.libka": {"css": "linear"}}}
    },
    "stagger": {"max": {"$type": "duration", "$value": {"value": 80, "unit": "ms"}}},
    "preset": {
      "$type": "transition",
      "fade": {
        "in": {
          "$value": {
            "duration": "{motion.duration.base}",
            "delay": {"value": 0, "unit": "ms"},
            "timingFunction": "{motion.ease.standard}"
          },
          "$extensions": {"org.libka": {"css": {"from": "opacity:0", "to": "opacity:1"}}}
        }
      },
      "rise": {
        "in": {
          "$value": {
            "duration": "{motion.duration.slow}",
            "delay": {"value": 0, "unit": "ms"},
            "timingFunction": "{motion.ease.soft}"
          },
          "$extensions": {
            "org.libka": {"css": {"from": "opacity:0;transform:translateY(8px)", "to": "opacity:1;transform:translateY(0)"}}
          }
        }
      },
      "lift": {
        "hover": {
          "$value": {
            "duration": "{motion.duration.fast}",
            "delay": {"value": 0, "unit": "ms"},
            "timingFunction": "{motion.ease.standard}"
          },
          "$extensions": {"org.libka": {"css": {"to": "transform:translateY(-2px)"}}}
        }
      },
      "drawer": {
        "in": {
          "$value": {
            "duration": "{motion.duration.slow}",
            "delay": {"value": 0, "unit": "ms"},
            "timingFunction": "{motion.ease.soft}"
          },
          "$extensions": {"org.libka": {"css": {"from": "transform:translateX(100%)", "to": "transform:translateX(0)"}}}
        }
      },
      "modal": {
        "in": {
          "$value": {
            "duration": "{motion.duration.base}",
            "delay": {"value": 0, "unit": "ms"},
            "timingFunction": "{motion.ease.soft}"
          },
          "$extensions": {"org.libka": {"css": {"from": "opacity:0;transform:scale(.98)", "to": "opacity:1;transform:scale(1)"}}}
        }
      }
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "xs": {"$value": {"value": 12, "unit": "px"}},
      "sm": {"$value": {"value": 16, "unit": "px"}},
      "md": {"$value": {"value": 20, "unit": "px"}},
      "lg": {"$value": {"value": 24, "unit": "px"}},
      "xl": {"$value": {"value": 32, "unit": "px"}},
      "2xl": {"$value": {"value": 48, "unit": "px"}}
    },
    "stroke": {
      "$type": "dimension",
      "at-16": {"$value": {"value": 1.5, "unit": "px"}},
      "at-20": {"$value": {"value": 1.75, "unit": "px"}},
      "at-24-plus": {"$value": {"value": 2, "unit": "px"}}
    },
    "color": {
      "$type": "color",
      "primary": {"$value": "{color.semantic.text.primary}"},
      "secondary": {"$value": "{color.semantic.text.secondary}"},
      "muted": {"$value": "{color.semantic.text.muted}"},
      "on-dark": {"$value": "{color.primitive.cloud.50}"},
      "accent": {"$value": "{color.semantic.action.accent}"},
      "ai": {"$value": "{color.semantic.action.iris}"},
      "status": {
        "success": {"$value": "{color.semantic.status.success}"},
        "warning": {"$value": "{color.semantic.status.warning}"},
        "error": {"$value": "{color.semantic.status.error}"},
        "info": {"$value": "{color.semantic.status.info}"}
      }
    }
  },
  "visualization": {
    "$description": "Series colors and ordering verified: worst-case CIE76 deltaE = 17.1 across deuteranopia, protanopia and tritanopia (threshold 15). Pattern fills are mandatory for print and for charts with 4+ series.",
    "series": {
      "$type": "color",
      "1": {
        "$value": {"colorSpace": "srgb", "components": [0.0588, 0.5608, 0.6314], "hex": "#0F8FA1"},
        "$description": "Deep Aqua",
        "$extensions": {"org.libka": {"pattern": "solid"}}
      },
      "2": {
        "$value": {"colorSpace": "srgb", "components": [0.4784, 0.4863, 1.0], "hex": "#7A7CFF"},
        "$description": "Soft Iris",
        "$extensions": {"org.libka": {"pattern": "diagonal-lines"}}
      },
      "3": {
        "$value": {"colorSpace": "srgb", "components": [0.9412, 0.702, 0.3686], "hex": "#F0B35E"},
        "$description": "Soft Apricot",
        "$extensions": {"org.libka": {"pattern": "dots"}}
      },
      "4": {
        "$value": {"colorSpace": "srgb", "components": [0.0863, 0.3882, 0.2471], "hex": "#16633F"},
        "$description": "Forest Mint",
        "$extensions": {"org.libka": {"pattern": "cross-hatch"}}
      },
      "5": {
        "$value": {"colorSpace": "srgb", "components": [0.8471, 0.3412, 0.4196], "hex": "#D8576B"},
        "$description": "Calm Coral",
        "$extensions": {"org.libka": {"pattern": "horizontal-lines"}}
      },
      "6": {
        "$value": {"colorSpace": "srgb", "components": [0.7216, 0.7529, 0.8], "hex": "#B8C0CC"},
        "$description": "Light Slate",
        "$extensions": {"org.libka": {"pattern": "vertical-lines"}}
      }
    },
    "axis": {
      "$type": "color",
      "color": {"$value": "{color.semantic.border.default}"},
      "label": {"$value": "{color.semantic.text.muted}"}
    },
    "grid": {
      "color": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8431, 0.8667, 0.9059], "alpha": 0.6}}
    },
    "tooltip": {
      "background": {"$type": "color", "$value": "{color.primitive.ink.950}"},
      "text": {"$type": "color", "$value": "{color.primitive.cloud.50}"},
      "radius": {"$type": "dimension", "$value": "{radius.md}"}
    },
    "highlight": {"stroke": {"$type": "color", "$value": "{color.semantic.action.accent}"}}
  }
}
