{
  "color": {
    "$type": "color",
    "component": {
      "button": {
        "primary": {
          "background": {"$value": "{color.semantic.action.primary}"},
          "text": {"$value": "{color.semantic.bg.canvas}"},
          "hover": {"background": {"$value": {"colorSpace": "srgb", "components": [0.1647, 0.2, 0.2706], "hex": "#2A3345"}}},
          "focus": {"ring": {"$value": "{color.semantic.focus.ring}"}},
          "disabled": {"opacity": {"$type": "number", "$value": "{opacity.disabled}"}}
        },
        "accent": {
          "background": {"$value": "{color.semantic.action.accent-strong}"},
          "text": {"$value": "{color.semantic.action.on-accent}"},
          "hover": {"background": {"$value": {"colorSpace": "srgb", "components": [0.0078, 0.3765, 0.4235], "hex": "#02606C"}}},
          "focus": {"ring": {"$value": "{color.semantic.focus.ring}"}}
        },
        "iris": {
          "background": {"$value": "{color.semantic.action.iris}"},
          "text": {"$value": "{color.semantic.action.on-iris}"},
          "hover": {"background": {"$value": {"colorSpace": "srgb", "components": [0.2431, 0.251, 0.6588], "hex": "#3E40A8"}}},
          "focus": {"ring": {"$value": "{color.semantic.focus.ring}"}}
        },
        "secondary": {
          "background": {"$value": "{color.semantic.bg.surface}"},
          "border": {"$value": "{color.semantic.border.default}"},
          "text": {"$value": "{color.semantic.text.primary}"}
        },
        "destructive": {
          "background": {"$value": "{color.semantic.action.destructive}"},
          "text": {"$value": "{color.semantic.action.on-destructive}"}
        },
        "ghost": {
          "background": {
            "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0},
            "$extensions": {"org.libka": {"css": "transparent"}}
          },
          "text": {"$value": "{color.semantic.text.secondary}"},
          "hover": {"background": {"$value": "{color.semantic.bg.elevated}"}}
        }
      },
      "input": {
        "background": {"$value": "{color.semantic.bg.surface}"},
        "border": {
          "default": {"$value": "{color.semantic.border.control}"},
          "focus": {"$value": "{color.semantic.action.accent}"},
          "error": {"$value": "{color.semantic.status.error}"}
        },
        "text": {"$value": "{color.semantic.text.primary}"},
        "placeholder": {"$value": "{color.semantic.text.muted}"},
        "label": {"$value": "{color.semantic.text.primary}"},
        "helper": {"$value": "{color.semantic.text.secondary}"},
        "error": {"text": {"$value": "{color.semantic.text.error}"}}
      },
      "card": {
        "background": {"$value": "{color.semantic.bg.surface}"},
        "border": {"$value": "{color.semantic.border.default}"},
        "shadow": {"$type": "shadow", "$value": "{shadow.2}"},
        "ai": {
          "border": {"$value": "{color.semantic.action.iris}"},
          "tint": {"$value": {"colorSpace": "srgb", "components": [0.298, 0.3059, 0.8], "alpha": 0.05}}
        }
      },
      "badge": {
        "success": {
          "background": {"$value": {"colorSpace": "srgb", "components": [0.1804, 0.5451, 0.3961], "alpha": 0.12}},
          "text": {"$value": "{color.semantic.text.success}"}
        },
        "info": {
          "background": {"$value": {"colorSpace": "srgb", "components": [0.0588, 0.5608, 0.6314], "alpha": 0.12}},
          "text": {"$value": "{color.semantic.text.info}"}
        },
        "warning": {
          "background": {"$value": {"colorSpace": "srgb", "components": [0.9412, 0.702, 0.3686], "alpha": 0.16}},
          "text": {"$value": "{color.semantic.text.warning}"}
        },
        "error": {
          "background": {"$value": {"colorSpace": "srgb", "components": [0.8471, 0.3412, 0.4196], "alpha": 0.12}},
          "text": {"$value": "{color.semantic.text.error}"}
        },
        "ai": {
          "background": {"$value": {"colorSpace": "srgb", "components": [0.298, 0.3059, 0.8], "alpha": 0.1}},
          "text": {"$value": "{color.semantic.text.ai}"}
        }
      },
      "nav": {
        "item": {
          "active": {
            "background": {"$value": {"colorSpace": "srgb", "components": [0.0588, 0.5608, 0.6314], "alpha": 0.1}},
            "text": {"$value": "{color.semantic.text.primary}"}
          },
          "hover": {"background": {"$value": "{color.semantic.bg.elevated}"}},
          "default": {"text": {"$value": "{color.semantic.text.secondary}"}}
        }
      },
      "table": {
        "header": {
          "background": {"$value": "{color.semantic.bg.elevated}"},
          "text": {"$value": "{color.semantic.text.primary}"}
        },
        "row": {
          "default": {"$value": "{color.semantic.bg.surface}"},
          "hover": {"$value": {"colorSpace": "srgb", "components": [0.0588, 0.5608, 0.6314], "alpha": 0.05}},
          "selected": {"$value": {"colorSpace": "srgb", "components": [0.0588, 0.5608, 0.6314], "alpha": 0.1}}
        },
        "border": {"$value": "{color.semantic.border.default}"},
        "cell": {
          "padding": {"y": {"$type": "dimension", "$value": "{spacing.3}"}, "x": {"$type": "dimension", "$value": "{spacing.4}"}}
        }
      },
      "modal": {
        "background": {"$value": "{color.semantic.bg.surface}"},
        "overlay": {"$value": {"colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "alpha": 0.48}},
        "shadow": {"$type": "shadow", "$value": "{shadow.3}"}
      },
      "drawer": {"background": {"$value": "{color.semantic.bg.surface}"}, "shadow": {"$type": "shadow", "$value": "{shadow.4}"}}
    }
  }
}
